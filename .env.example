# ============================================================
# forecast-market-asia — variables de entorno
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ⚠️ CRÍTICO para los crons: key de servicio (service_role). Con solo la anon
# key, RLS bloquea los INSERT/UPDATE de daily.ts y los guardados fallan
# SILENCIOSAMENTE (el cron responde 200 igual). Encuéntrala en:
# Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_KEY=your-service-key

# --- Vercel Cron ---
# Debe coincidir con la env var CRON_SECRET del proyecto en Vercel.
# Los crons llaman a /api/cron/daily con "Authorization: Bearer <secret>".
CRON_SECRET=your-cron-secret

# --- Open-Meteo (RECOMENDADO) ---
# API key propia (gratis para uso no-comercial, ~10k llamadas/día):
#   1. Crear cuenta en https://open-meteo.com/en/docs
#   2. Copiar la API key de "API Keys" en el dashboard
# SIN key: la cuota diaria se cuenta por IP. En Vercel las funciones salen por
# IPs NAT COMPARTIDOS con otras apps — el IP puede llegar ya agotado (HTTP 429
# "Daily API request limit exceeded"), causando corridas con 2/10 o 8/10
# ciudades. CON key la cuota es propia y estable.
# (El código tiene fallback TWC por ciudad mientras tanto.)
OPENMETEO_API_KEY=

# --- TWC / weather.com (opcional) ---
# Key para temperaturas reales de estaciones + fallback de pronóstico.
# Si se deja vacía se usa la key pública por defecto (compartida).
TWC_API_KEY=

# --- Polymarket (polyclawd) ---
POLYGON_RPC=
POLYMARKET_START_BLOCK=33605403
