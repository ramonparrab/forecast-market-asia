# ============================================================
# forecast-market-asia — variables de entorno
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ⚠️ CRÍTICO para los crons: key de servicio (service_role). Con solo la anon
# key, RLS bloquea los INSERT/UPDATE de daily.ts y los guardados fallan
# SILENCIOSAMENTE (el cron responde 200 igual). Encuéntrala en:
# Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_KEY=your-service-key

# --- Vercel Cron ---
# Debe coincidir con la env var CRON_SECRET del proyecto en Vercel.
# Los crons llaman a /api/cron/daily con "Authorization: Bearer <secret>".
CRON_SECRET=your-cron-secret

# --- Open-Meteo (OPCIONAL) ---
# NOTA 2026-09: open-meteo.com ya NO emite keys gratis (solo comercial vía
# Stripe). Sin key, la cuota diaria se cuenta por IP. En Vercel las funciones
# salen por IPs NAT COMPARTIDOS con otras apps — el IP puede llegar ya agotado
# (HTTP 429 "Daily API request limit exceeded"), causando degradación a 1
# modelo. El código se protege solito: OWM en paralelo + fallback TWC.
# (El código tiene fallback TWC por ciudad mientras tanto.)
OPENMETEO_API_KEY=

# --- OpenWeatherMap (RECOMENDADO — key ya creada) ---
# Free tier: 1.000 llamadas/día (la app usa ~60/día). Registro gratis en
#   https://openweathermap.org/api → Sign up. La key nueva tarda ~2h en activar
#   (HTTP 401 mientras tanto — es normal).
# Aporta el modelo 'owm' al ensemble (en paralelo con Open-Meteo) y actúa como
# segundo fallback (antes que TWC) si Open-Meteo da 429.
OPENWEATHERMAP_API_KEY=

# --- TWC / weather.com (opcional) ---
# Key para temperaturas reales de estaciones + fallback de pronóstico.
# Si se deja vacía se usa la key pública por defecto (compartida).
TWC_API_KEY=

# --- Polymarket (polyclawd) ---
POLYGON_RPC=
POLYMARKET_START_BLOCK=33605403
